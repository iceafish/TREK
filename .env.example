# TREK environment — copy to .env and fill in. Placeholders only; never commit
# real values (.env is gitignored).

# ── AMap / 高德 (docs/amap/) ──────────────────────────────────────────────────
# Web 端 JS API key: browser-public by design — the JS API loader sends it with
# every map request. Also settable as the `amap_js_key` admin default; the env
# value wins when both are present.
# AMAP_JS_KEY=
# Server secrets. Appended to /_AMapService proxy requests (package 03) and
# used for server-side REST calls. These must NEVER reach the browser — do not
# add them to user-facing settings or client bundles.
# AMAP_SECURITY_CODE=
# AMAP_WEB_SERVICE_KEY=
