# TREK was migrated from npm workspaces, and parts of the toolchain rely on
# npm's flat layout: the Dockerfile preflight checks /app/node_modules/<pkg>,
# tsconfig-paths/register resolves the MCP SDK from the hoisted tree at
# runtime, and the plugin sandbox spawns child node processes that walk up.
# node-linker=hoisted keeps that behavior identical (no .pnpm symlinks).
node-linker=hoisted
